{
  "name": "jebtosendit",
  "version": "0.4.0",
  "description": "Turn a JEB into Enter, a command or a script. Microphone impact detection for Windows and macOS.",
  "author": "JebToSendIt",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "icon": "node tools/gen-icon.js",
    "vendor": "node tools/sync-vendor.js",
    "postinstall": "npm run vendor",
    "start": "electron .",
    "prepare:build": "npm run vendor && npm run icon",
    "build": "npm run prepare:build && electron-builder --publish never",
    "build:win": "npm run build -- --win nsis portable --x64",
    "build:mac": "npm run build -- --mac dmg zip --arm64 --x64",
    "notarize:dmg": "node tools/notarize-dmg.js",
    "dist": "npm run build",
    "test": "node --test",
    "check": "node tools/check.js",
    "smoke": "electron tools/smoke.js"
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.1"
  },
  "dependencies": {
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11",
    "i18next": "^26.7.1"
  },
  "build": {
    "appId": "com.jebtosendit.app",
    "productName": "JebToSendIt",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "JebToSendIt-${version}-portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png",
      "artifactName": "${productName}-${version}-macos-${arch}.${ext}",
      "hardenedRuntime": true,
      "entitlements": "assets/signing/entitlements.mac.plist",
      "entitlementsInherit": "assets/signing/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "JebToSendIt listens for impacts to trigger your chosen action.",
        "NSAppleEventsUsageDescription": "JebToSendIt uses System Events to send Enter to the active application."
      }
    },
    "dmg": {
      "sign": true,
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "writeUpdateInfo": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "doctorspider42",
        "repo": "JebToSendIt",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "artifactName": "JebToSendIt-${version}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": ">=26 <27"
  }
}
